run_broadcast() {
  local cmd="$1"
  shift || true

  local am_bin=""
  if command -v termux-am >/dev/null 2>&1; then
    am_bin="$(command -v termux-am)"
  elif [ -x /system/bin/am ]; then
    am_bin="/system/bin/am"
  else
    fail_json "Neither termux-am nor /system/bin/am is available"
  fi

  local output status
  set +e
  output="$("$am_bin" broadcast --receiver-foreground -n "$RECEIVER" -a "$ACTION" --es cmd "$cmd" "$@" 2>&1)"
  status=$?
  set -e

  if [ "$status" -ne 0 ]; then
    fail_json "$output" "$status"
  fi

  local line result_code data
  line="$(printf '%s\n' "$output" | sed -n 's/^Broadcast completed: result=\([-0-9][0-9]*\), data="\(.*\)"$/\1	\2/p' | tail -n 1)"
  if [ -z "$line" ]; then
    fail_json "Unexpected bridge response: $output"
  fi

  result_code="${line%%	*}"
  data="${line#*	}"

  printf '%s\n' "$data"
  case "$result_code" in
    ''|*[!0-9-]*)
      exit 1
      ;;
    *)
      if [ "$result_code" -eq 0 ]; then
        exit 0
      fi
      exit 1
      ;;
  esac
}

# Socket path for ANR-safe long-running operations (aicore). TERMUX_AI_SOCKET
# overrides it (used by the test stubs).
SOCKET_PATH="${TERMUX_AI_SOCKET:-/data/data/com.termux/files/apps/com.termux/termux-ai/ai.sock}"

# socket_request JSON -> response in SOCKET_RESPONSE.
# Returns EX_NOSOCKET when there is no socket (nothing was sent) and
# EX_TRANSPORT when the exchange failed after the request was written.
SOCKET_ERROR=""
SOCKET_RESPONSE=""
socket_request() {
  local json_payload="$1" response status
  SOCKET_ERROR=""
  SOCKET_RESPONSE=""
  if [ ! -S "$SOCKET_PATH" ]; then
    SOCKET_ERROR="the Termux AI socket is not available ($SOCKET_PATH)"
    return "$EX_NOSOCKET"
  fi
  if ! command -v nc >/dev/null 2>&1; then
    SOCKET_ERROR="nc (netcat) is required to talk to the Termux AI socket"
    return "$EX_NOSOCKET"
  fi
  # No set +e / set -e here: toggling errexit inside the function would re-arm
  # it in the caller and end the script before the error is reported.
  if response="$(printf '%s\n' "$json_payload" | nc -U "$SOCKET_PATH" 2>/dev/null)"; then
    status=0
  else
    status=$?
  fi
  if [ "$status" -ne 0 ]; then
    SOCKET_ERROR="the connection to the Termux AI socket failed after the request was sent; it was not retried"
    return "$EX_TRANSPORT"
  fi
  if [ -z "${response//[[:space:]]/}" ]; then
    SOCKET_ERROR="the Termux AI app closed the connection without a response after the request was sent; it was not retried"
    return "$EX_TRANSPORT"
  fi
  SOCKET_RESPONSE="$response"
}

# tty_sanitize FD VARNAME: text that comes from the model or the app is not
# trusted. When FD is a terminal, control characters other than newline and tab
# (ESC, BEL, DEL, the C1 range) are shown as "?" so an answer cannot move the
# cursor, change the title or write to the clipboard. Pipes and files get the
# text unchanged.
tty_sanitize() {
  [ -t "$1" ] || return 0
  local -n ref="$2"
  ref=${ref//[$'\001'-$'\010'$'\013'-$'\037'$'\177']/?}
  ref=${ref//$'\302'[$'\200'-$'\237']/?}
}

# emit_error MODE MESSAGE CODE: text mode writes to stderr, json mode writes a
# JSON error object to stdout. Always exits.
emit_error() {
  local mode="$1" message="$2" code="$3"
  if [ "$mode" = "json" ]; then
    printf '{"ok":false,"error":%s}\n' "$(json_string "$message")"
  else
    tty_sanitize 2 message
    printf 'termux-ai: error: %s\n' "$message" >&2
  fi
  exit "$code"
}

# describe_app_error: error text of a parsed ok:false response, with the AICore
# error name, code and retry delay when the app reported them.
describe_app_error() {
  local message="${J[error]:-unknown error}" extra=""
  [ -z "${J[error_name]:-}" ] || extra="${J[error_name]}"
  if [ -n "${J[error_code]:-}" ]; then extra="${extra:+$extra, }code ${J[error_code]}"; fi
  if [ -n "${J[retry_delay_ms]:-}" ]; then extra="${extra:+$extra, }retry after ${J[retry_delay_ms]} ms"; fi
  if [ -n "${J[backend_requested]:-}" ]; then extra="${extra:+$extra, }backend ${J[backend_requested]}"; fi
  if [ -n "${J[phase]:-}" ]; then extra="${extra:+$extra, }phase ${J[phase]}"; fi
  if [ -n "$extra" ]; then message="$message ($extra)"; fi
  printf '%s' "$message"
}

# handle_response MODE KIND RAW: validates RAW and prints it according to MODE.
# KIND "text" prints data.text in text mode; any other KIND prints the JSON.
# Exits non-zero for ok:false, an empty or malformed response, or a missing ok.
handle_response() {
  local mode="$1" kind="$2" raw="$3"
  if [ -z "${raw//[[:space:]]/}" ]; then
    emit_error "$mode" "empty response from the Termux AI app" "$EX_APP"
  fi
  if ! json_parse "$raw"; then
    emit_error "$mode" "malformed response from the Termux AI app: $JP_ERR" "$EX_APP"
  fi
  if [ "${JT[ok]:-}" != "boolean" ]; then
    emit_error "$mode" "response from the Termux AI app has no ok field" "$EX_APP"
  fi
  if [ "${J[ok]}" != "true" ]; then
    if [ "$mode" = "json" ] || [ "$kind" != "text" ]; then
      printf '%s\n' "$raw"
      exit "$EX_APP"
    fi
    emit_error "$mode" "$(describe_app_error)" "$EX_APP"
  fi
  # A generate answer without data.text is unusable in either mode. The paths are unambiguous, so these are
  # the types of the root's own "data" and of that object's "text".
  if [ "$kind" = "text" ] && { [ "${JT[data]:-}" != "object" ] || [ "${JT[data.text]:-}" != "string" ]; }; then
    emit_error "$mode" "response from the Termux AI app has no data.text (data must be an object with a text string)" "$EX_APP"
  fi
  if [ "$mode" = "json" ] || [ "$kind" != "text" ]; then
    printf '%s\n' "$raw"
    return 0
  fi
  if [ -z "${J[data.text]}" ]; then
    emit_error "$mode" "the model returned an empty completion (finish_reason ${J[data.finish_reason]:-unknown})" "$EX_APP"
  fi
  local answer="${J[data.text]}"
  tty_sanitize 1 answer
  printf '%s\n' "$answer"
}

read_stdin_or_args() {
  if [ "$#" -gt 0 ]; then
    printf '%s' "$*"
  else
    cat
  fi
}

api_compat() {
  local method="${1:-}"
  if [ -n "$method" ]; then shift || true; fi
  case "$method" in
    AudioInfo) run_broadcast audio.info "$@" ;;
    BatteryStatus) run_broadcast sys.battery "$@" ;;
    Brightness) run_broadcast display.brightness "$@" ;;
    CameraInfo) run_broadcast camera.info "$@" ;;
    Clipboard) run_broadcast "${1:-sys.clipboard.get}" "${@:2}" ;;
    Notification) run_broadcast notification.show "$@" ;;
    NotificationChannel) run_broadcast notification.channel "$@" ;;
    NotificationRemove) run_broadcast notification.remove "$@" ;;
    TextToSpeech)
      if [ "${1:-}" = "LIST_AVAILABLE" ]; then
        run_broadcast tts.engines
      else
        run_broadcast tts.speak "$@"
      fi
      ;;
    Toast) run_broadcast ui.toast "$@" ;;
    Torch) run_broadcast camera.torch "$@" ;;
    Vibrate) run_broadcast sys.vibrate "$@" ;;
    Volume) run_broadcast "${1:-audio.volume.list}" "${@:2}" ;;
    WifiConnectionInfo) run_broadcast wifi.connection "$@" ;;
    *) fail_json "Unsupported internal API method: $method" ;;
  esac
}

compat_main() {
  case "$SELF" in
    termux-api)
      api_compat "$@"
      ;;
    termux-audio-info)
      run_broadcast audio.info
      ;;
    termux-battery-status)
      run_broadcast sys.battery
      ;;
    termux-brightness)
      [ "$#" -eq 1 ] || fail_json "Usage: termux-brightness brightness|auto"
      if [ "$1" = "auto" ]; then run_broadcast display.brightness --ez auto true; else run_broadcast display.brightness --ei brightness "$1"; fi
      ;;
    termux-camera-info)
      run_broadcast camera.info
      ;;
    termux-clipboard-get)
      run_broadcast sys.clipboard.get
      ;;
    termux-clipboard-set)
      run_broadcast sys.clipboard.set --es text "$(read_stdin_or_args "$@")"
      ;;
    termux-notification)
      local title="termux-ai" content="" id="1773" channel="termux_ai_bridge" ongoing="false"
      while [ "$#" -gt 0 ]; do
        case "$1" in
          -t|--title) title="$2"; shift 2 ;;
          -c|--content) content="$2"; shift 2 ;;
          -i|--id) id="$2"; shift 2 ;;
          --channel) channel="$2"; shift 2 ;;
          --ongoing) ongoing="true"; shift ;;
          -h|--help) printf 'Usage: termux-notification [-t title] [-c content] [-i id] [--channel id] [--ongoing]\n'; exit 0 ;;
          *) fail_json "Unsupported termux-notification option: $1" ;;
        esac
      done
      [ -n "$content" ] || content="$(read_stdin_or_args)"
      run_broadcast notification.show --es title "$title" --es text "$content" --es id "$id" --es channel "$channel" --ez ongoing "$ongoing"
      ;;
    termux-notification-channel)
      if [ "${1:-}" = "-d" ]; then
        [ "$#" -eq 2 ] || fail_json "Usage: termux-notification-channel -d channel-id"
        run_broadcast notification.channel --ez delete true --es id "$2"
      else
        [ "$#" -eq 2 ] || fail_json "Usage: termux-notification-channel channel-id channel-name"
        run_broadcast notification.channel --es id "$1" --es name "$2"
      fi
      ;;
    termux-notification-remove)
      [ "$#" -eq 1 ] || fail_json "Usage: termux-notification-remove notification-id"
      run_broadcast notification.remove --es id "$1"
      ;;
    termux-toast)
      local short="false"
      while getopts :hs option; do
        case "$option" in
          h) printf 'Usage: termux-toast [-s] [text]\n'; exit 0 ;;
          s) short="true" ;;
          ?) fail_json "Illegal option -$OPTARG" ;;
        esac
      done
      shift $((OPTIND-1))
      run_broadcast ui.toast --ez short "$short" --es text "$(read_stdin_or_args "$@")"
      ;;
    termux-torch)
      [ "$#" -eq 1 ] || fail_json "Usage: termux-torch on|off"
      case "$1" in
        on) run_broadcast camera.torch --ez enabled true ;;
        off) run_broadcast camera.torch --ez enabled false ;;
        *) fail_json "Usage: termux-torch on|off" ;;
      esac
      ;;
    termux-tts-engines)
      run_broadcast tts.engines
      ;;
    termux-tts-speak)
      local args=()
      while getopts :he:l:n:v:p:r:s: option; do
        case "$option" in
          h) printf 'Usage: termux-tts-speak [-e engine] [-l language] [-n region] [-v variant] [-p pitch] [-r rate] [-s stream] [text]\n'; exit 0 ;;
          e) args+=(--es engine "$OPTARG") ;;
          l) args+=(--es language "$OPTARG") ;;
          n) args+=(--es region "$OPTARG") ;;
          v) args+=(--es variant "$OPTARG") ;;
          p) args+=(--ef pitch "$OPTARG") ;;
          r) args+=(--ef rate "$OPTARG") ;;
          s) args+=(--es stream "$OPTARG") ;;
          ?) fail_json "Illegal option -$OPTARG" ;;
        esac
      done
      shift $((OPTIND-1))
      run_broadcast tts.speak "${args[@]}" --es text "$(read_stdin_or_args "$@")"
      ;;
    termux-vibrate)
      local duration=1000
      while getopts :hd: option; do
        case "$option" in
          h) printf 'Usage: termux-vibrate [-d duration_ms]\n'; exit 0 ;;
          d) duration="$OPTARG" ;;
          ?) fail_json "Illegal option -$OPTARG" ;;
        esac
      done
      run_broadcast sys.vibrate --ei duration_ms "$duration"
      ;;
    termux-volume)
      if [ "$#" -eq 0 ]; then
        run_broadcast audio.volume.list
      elif [ "$#" -eq 2 ]; then
        run_broadcast audio.volume --es stream "$1" --ei volume "$2"
      else
        fail_json "Usage: termux-volume [stream volume]"
      fi
      ;;
    termux-wifi-connectioninfo)
      run_broadcast wifi.connection
      ;;
    *)
      return 1
      ;;
  esac
}

AI_STAGE=""
AI_PREFERENCE=""

aicore_need_value() {
  [ "$#" -ge 2 ] || emit_error text "$1 needs a value" "$EX_USAGE"
}

# aicore_check_selection MODE STAGE PREFERENCE: unknown values are errors, never
# silently replaced by a default.
aicore_check_selection() {
  local mode="$1" stage="$2" preference="$3"
  case "$stage" in ''|stable|preview) ;; *) emit_error "$mode" "--stage must be stable or preview (got: $stage)" "$EX_USAGE" ;; esac
  case "$preference" in ''|full|fast) ;; *) emit_error "$mode" "--preference must be full or fast (got: $preference)" "$EX_USAGE" ;; esac
}

# aicore_parse_selection ARGS...: --stage and --preference only.
aicore_parse_selection() {
  AI_STAGE=""
  AI_PREFERENCE=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --stage) aicore_need_value "$@"; AI_STAGE="$2"; shift 2 ;;
      --preference) aicore_need_value "$@"; AI_PREFERENCE="$2"; shift 2 ;;
      *) emit_error text "Unknown option: $1" "$EX_USAGE" ;;
    esac
  done
  aicore_check_selection text "$AI_STAGE" "$AI_PREFERENCE"
}

# aicore_selection_json STAGE PREFERENCE [LEADING_COMMA]
aicore_selection_json() {
  local stage="$1" preference="$2" lead="${3:-}" out=""
  [ -z "$stage" ] || out="\"stage\":$(json_string "$stage")"
  if [ -n "$preference" ]; then out="${out:+$out,}\"preference\":$(json_string "$preference")"; fi
  if [ -n "$out" ] && [ -n "$lead" ]; then out="$lead$out"; fi
  printf '%s' "$out"
}

main() {
  if compat_main "$@"; then
    return
  fi

  local command="${1:-}"
  if [ -n "$command" ]; then
    shift || true
  fi

  case "$command" in
    --version|-V)
      printf '{"ok":true,"version":"%s"}\n' "$VERSION"
      ;;
    --help|-h|help)
      usage
      ;;
    doctor)
      run_broadcast bridge.version
      ;;
    api)
      case "${1:-}" in
        list) run_broadcast api.list ;;
        *) fail_json "Usage: termux-ai api list" ;;
      esac
      ;;
    ping)
      run_broadcast ping
      ;;
    info)
      run_broadcast sys.info
      ;;
    battery)
      run_broadcast sys.battery
      ;;
    clipboard)
      case "${1:-}" in
        get)
          run_broadcast sys.clipboard.get
          ;;
        set)
          shift || true
          run_broadcast sys.clipboard.set --es text "$*"
          ;;
        *)
          fail_json "Usage: termux-ai clipboard get|set TEXT"
          ;;
      esac
      ;;
    tts)
      case "${1:-}" in
        engines) run_broadcast tts.engines ;;
        speak) shift || true; run_broadcast tts.speak --es text "$(read_stdin_or_args "$@")" ;;
        *) fail_json "Usage: termux-ai tts engines|speak TEXT" ;;
      esac
      ;;
    toast)
      run_broadcast ui.toast --es text "$(read_stdin_or_args "$@")"
      ;;
    volume)
      if [ "$#" -eq 0 ]; then
        run_broadcast audio.volume.list
      elif [ "$#" -eq 2 ]; then
        run_broadcast audio.volume --es stream "$1" --ei volume "$2"
      else
        fail_json "Usage: termux-ai volume [stream volume]"
      fi
      ;;
    audio)
      [ "${1:-}" = "info" ] || fail_json "Usage: termux-ai audio info"
      run_broadcast audio.info
      ;;
    brightness)
      [ "$#" -eq 1 ] || fail_json "Usage: termux-ai brightness LEVEL|auto"
      if [ "$1" = "auto" ]; then run_broadcast display.brightness --ez auto true; else run_broadcast display.brightness --ei brightness "$1"; fi
      ;;
    torch)
      [ "$#" -eq 1 ] || fail_json "Usage: termux-ai torch on|off"
      case "$1" in
        on) run_broadcast camera.torch --ez enabled true ;;
        off) run_broadcast camera.torch --ez enabled false ;;
        *) fail_json "Usage: termux-ai torch on|off" ;;
      esac
      ;;
    camera)
      [ "${1:-}" = "info" ] || fail_json "Usage: termux-ai camera info"
      run_broadcast camera.info
      ;;
    notify)
      local title="${1:-termux-ai}"
      shift || true
      run_broadcast notification.show --es title "$title" --es text "$*"
      ;;
    wifi)
      [ "${1:-}" = "connection" ] || fail_json "Usage: termux-ai wifi connection"
      run_broadcast wifi.connection
      ;;
    aicore)
      local sub="${1:-info}"
      shift || true
      case "$sub" in
        info|models)
          local stage="" preference=""
          if [ "$sub" = "models" ] && [ "$#" -gt 0 ]; then
            emit_error text "aicore models takes no options (it checks all four combinations)" "$EX_USAGE"
          fi
          aicore_parse_selection "$@"
          stage="$AI_STAGE"; preference="$AI_PREFERENCE"
          local args_json="" extras=()
          if [ "$sub" = "info" ]; then
            args_json="$(aicore_selection_json "$stage" "$preference")"
            [ -z "$stage" ] || extras+=(--es stage "$stage")
            [ -z "$preference" ] || extras+=(--es preference "$preference")
          fi
          # Read-only commands: when the socket cannot be used, the broadcast is
          # a safe fallback (repeating them changes nothing).
          local status
          set +e
          socket_request "{\"cmd\":\"aicore.$sub\",\"args\":{$args_json}}"
          status=$?
          set -e
          if [ "$status" -eq 0 ]; then
            handle_response json "$sub" "$SOCKET_RESPONSE"
          else
            run_broadcast "aicore.$sub" "${extras[@]}"
          fi
          ;;
        download)
          local stage="" preference="" status
          aicore_parse_selection "$@"
          stage="$AI_STAGE"; preference="$AI_PREFERENCE"
          # A download is long and has an effect: no broadcast fallback and no
          # retry, whatever goes wrong.
          set +e
          socket_request "{\"cmd\":\"aicore.download\",\"args\":{$(aicore_selection_json "$stage" "$preference")}}"
          status=$?
          set -e
          [ "$status" -eq 0 ] || emit_error json "$SOCKET_ERROR" "$status"
          handle_response json download "$SOCKET_RESPONSE"
          ;;
        generate)
          local prompt="" max_tokens=256 temperature=0.2 top_k="" stage="" preference="" mode="text"
          while [ "$#" -gt 0 ]; do
            case "$1" in
              --max-tokens) aicore_need_value "$@"; max_tokens="$2"; shift 2 ;;
              --temperature) aicore_need_value "$@"; temperature="$2"; shift 2 ;;
              --top-k) aicore_need_value "$@"; top_k="$2"; shift 2 ;;
              --stage) aicore_need_value "$@"; stage="$2"; shift 2 ;;
              --preference) aicore_need_value "$@"; preference="$2"; shift 2 ;;
              --json) mode="json"; shift ;;
              --text) mode="text"; shift ;;
              --) shift; prompt="$*"; break ;;
              -) prompt="$(cat -)"; shift ;;
              *) prompt="$*"; break ;;
            esac
          done
          [[ "$max_tokens" =~ ^[1-9][0-9]*$ ]] || emit_error "$mode" "--max-tokens must be a positive integer" "$EX_USAGE"
          [[ "$temperature" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || emit_error "$mode" "--temperature must be a number between 0 and 1, such as 0.2" "$EX_USAGE"
          if [ -n "$top_k" ]; then
            [[ "$top_k" =~ ^[1-9][0-9]*$ ]] || emit_error "$mode" "--top-k must be a positive integer" "$EX_USAGE"
          fi
          aicore_check_selection "$mode" "$stage" "$preference"
          [ -n "$prompt" ] || prompt="$(cat -)"
          [ -n "$prompt" ] || emit_error "$mode" "Usage: termux-ai aicore generate [--max-tokens N] [--temperature F] [--top-k N] [--stage S] [--preference P] PROMPT" "$EX_USAGE"

          local payload status
          payload="{\"cmd\":\"aicore.generate\",\"args\":{\"prompt\":$(json_string "$prompt"),\"max_tokens\":$max_tokens,\"temperature\":$temperature"
          [ -z "$top_k" ] || payload+=",\"top_k\":$top_k"
          payload+="$(aicore_selection_json "$stage" "$preference" ",")}}"
          # Once the request is on the wire it is never sent again: no broadcast
          # replay, no second socket attempt.
          set +e
          socket_request "$payload"
          status=$?
          set -e
          [ "$status" -eq 0 ] || emit_error "$mode" "$SOCKET_ERROR" "$status"
          handle_response "$mode" text "$SOCKET_RESPONSE"
          ;;
        *)
          fail_json "Usage: termux-ai aicore info|models|download|generate" "$EX_USAGE"
          ;;
      esac
      ;;
    litert)
      local sub="${1:-info}"
      shift || true
      case "$sub" in
        info|models)
          [ "$#" -eq 0 ] || emit_error text "litert $sub takes no options" "$EX_USAGE"
          # Read-only, but there is no broadcast path for the local-model engine: the socket is the only way.
          local status
          set +e
          socket_request "{\"cmd\":\"litert.$sub\",\"args\":{}}"
          status=$?
          set -e
          [ "$status" -eq 0 ] || emit_error json "$SOCKET_ERROR" "$status"
          handle_response json "$sub" "$SOCKET_RESPONSE"
          ;;
        generate)
          local prompt="" max_tokens="" temperature="" top_k="" backend="" model="" request_id="" mode="text"
          while [ "$#" -gt 0 ]; do
            case "$1" in
              --backend) aicore_need_value "$@"; backend="$2"; shift 2 ;;
              --model) aicore_need_value "$@"; model="$2"; shift 2 ;;
              --request-id) aicore_need_value "$@"; request_id="$2"; shift 2 ;;
              --max-tokens) aicore_need_value "$@"; max_tokens="$2"; shift 2 ;;
              --temperature) aicore_need_value "$@"; temperature="$2"; shift 2 ;;
              --top-k) aicore_need_value "$@"; top_k="$2"; shift 2 ;;
              --json) mode="json"; shift ;;
              --text) mode="text"; shift ;;
              --stage|--preference) emit_error "$mode" "$1 is an AICore option; litert takes --backend cpu|gpu|npu" "$EX_USAGE" ;;
              --) shift; prompt="$*"; break ;;
              -) prompt="$(cat -)"; shift ;;
              *) prompt="$*"; break ;;
            esac
          done
          # The backend is always explicit: nothing is guessed from the model name, and nothing falls back.
          case "$backend" in
            cpu|gpu|npu) ;;
            '') emit_error "$mode" "--backend is required (cpu, gpu or npu)" "$EX_USAGE" ;;
            *) emit_error "$mode" "--backend must be cpu, gpu or npu (got: $backend)" "$EX_USAGE" ;;
          esac
          [ -n "$model" ] || emit_error "$mode" "--model is required (see: termux-ai litert models)" "$EX_USAGE"
          [[ "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || emit_error "$mode" "--model must be a model id such as qwen3-0.6b" "$EX_USAGE"
          if [ -n "$request_id" ]; then
            [[ "$request_id" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || emit_error "$mode" "--request-id must be 1 to 64 characters of A-Z a-z 0-9 . _ -" "$EX_USAGE"
          else
            request_id="r$(date +%s)-$$-$RANDOM"
          fi
          if [ -n "$max_tokens" ]; then
            [[ "$max_tokens" =~ ^[1-9][0-9]*$ ]] || emit_error "$mode" "--max-tokens must be a positive integer" "$EX_USAGE"
          fi
          if [ -n "$temperature" ]; then
            [[ "$temperature" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]] || emit_error "$mode" "--temperature must be a number between 0 and 1, such as 0.2" "$EX_USAGE"
          fi
          if [ -n "$top_k" ]; then
            [[ "$top_k" =~ ^[1-9][0-9]*$ ]] || emit_error "$mode" "--top-k must be a positive integer" "$EX_USAGE"
          fi
          [ -n "$prompt" ] || prompt="$(cat -)"
          [ -n "$prompt" ] || emit_error "$mode" "Usage: termux-ai litert generate --backend cpu|gpu|npu --model ID [options] PROMPT" "$EX_USAGE"

          local payload status
          payload="{\"cmd\":\"litert.generate\",\"args\":{\"request_id\":$(json_string "$request_id"),\"model\":$(json_string "$model"),\"backend\":$(json_string "$backend"),\"prompt\":$(json_string "$prompt")"
          [ -z "$max_tokens" ] || payload+=",\"max_tokens\":$max_tokens"
          [ -z "$temperature" ] || payload+=",\"temperature\":$temperature"
          [ -z "$top_k" ] || payload+=",\"top_k\":$top_k"
          payload+="}}"
          # Once the request is on the wire it is never sent again: no second attempt, no other backend.
          set +e
          socket_request "$payload"
          status=$?
          set -e
          [ "$status" -eq 0 ] || emit_error "$mode" "$SOCKET_ERROR" "$status"
          handle_response "$mode" text "$SOCKET_RESPONSE"
          ;;
        *)
          fail_json "Usage: termux-ai litert info|models|generate" "$EX_USAGE"
          ;;
      esac
      ;;
    "")
      usage
      ;;
    *)
      fail_json "Unknown command: $command"
      ;;
  esac
}

# Sourcing the file (tests) only loads the functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
